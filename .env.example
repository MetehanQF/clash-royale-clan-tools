# Copy to /etc/crbot.env (bot) and /etc/clan-web.env (dashboard), owned by root, mode 0600.
# Never commit the real file.

# Clash Royale API key from https://developer.clashroyale.com
# Keys are bound to the public IP they were created for; a 403 usually means
# your home IP changed and the key needs that new address.
CR_API_KEY=

# Your clan tag, with or without the leading '#'  (e.g. #ABC123 or ABC123)
CLAN_TAG=

# --- bot only ---
# Token from @BotFather
TG_BOT_TOKEN=
# The group (or private chat) the bot reports to and accepts commands from.
# Group ids are negative, e.g. -1001234567890
TG_CHAT_ID=
